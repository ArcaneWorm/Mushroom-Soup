      m_Calls: []
  m_text: 'CONTROLS:

    - "WASD" or arrows to move

    - LEFT CLICK to interact
    with objects and buttons

    - RIGHT CLICK to consume items (just cattails for
    now)

    - "C" KEY to open and close crafting menu

    - LCLICK an item in
    the inventory to enter placement mode (if item can be placed). Press "Q" to cancel.

    -
    LCLICK and DRAG to move or throw away item in inventory'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
